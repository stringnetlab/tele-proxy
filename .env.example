# ========================================
# CONFIGURACIÓN DE ENTORNO - tele-proxy
# ========================================
# Lista de variables: docs/ENVIRONMENT.md (canónica). Ninguna variable que no esté ahí debe
# leerse el código. Los valores de este archivo son marcadores; `cp .env.example .env` y
# sustituye las tres credenciales antes de arrancar el compose.

# --- Aplicación ---
# No existe RUST_ENV: el entorno se distingue únicamente por RUST_LOG.
RUST_LOG=warn,tele_proxy=info
RUST_BACKTRACE=1

# --- Escucha HTTP ---
# Un solo host + dos puertos (no hay HTTP_*_ADDR): Pingora recibe la dirección ya compuesta.
HTTP_PROXY_PORT=8080
HTTP_CONTROL_PORT=8081
HTTP_HOST=0.0.0.0

# --- Runtime de Pingora (ServerConf) ---
# TRAMPA: threads vale 1 por defecto en Pingora. Sin PROXY_WORKER_THREADS el proxy es
# mono-thread aunque el host tenga 8 núcleos.
PROXY_WORKER_THREADS=4
PROXY_WORK_STEALING=true
PROXY_GRACE_PERIOD_SECONDS=10
UPSTREAM_KEEPALIVE_POOL_SIZE=128

# --- CouchDB ---
# La base COUCHDB_DB_NAME se crea a mano (docs/DEPLOYMENT.md); solo el design doc se autogenera.
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=supersecret
COUCHDB_DB_NAME=tele_proxy_configs
COUCHDB_TIMEOUT_MS=5000
COUCHDB_MAX_RETRIES=3

# --- Valkey ---
# VALKEY_URL la compone el docker-compose.yml desde VALKEY_PASSWORD
# (redis://:${VALKEY_PASSWORD}@valkey:6379); no la fijes aquí con la contraseña literal.
VALKEY_PASSWORD=valkeypass
VALKEY_MAX_CONNECTIONS=50
VALKEY_TIMEOUT_MS=3000

# --- Caché Local (Moka) ---
CONFIG_CACHE_TTL_SECONDS=300
CONFIG_CACHE_MAX_CAPACITY=10000

# --- Caché de Respuestas (Valkey) ---
DEFAULT_CACHE_TTL_SECONDS=3600
IP_CACHE_TTL_SECONDS=300
MAX_CACHEABLE_SIZE_BYTES=5242880

# --- Límites del Sistema ---
MAX_RESPONSE_SIZE_BYTES=104857600
MAX_SCRIPTING_BODY_BYTES=5242880
LUA_TIMEOUT_MS=200
LUA_MEMORY_LIMIT_MB=50
WEBHOOK_TIMEOUT_MS=5000

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_REQUESTS=50
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_RATE_LIMIT_RPM=10000

# --- DNS (DoT + DNSSEC) ---
# La lista primaria vive en config/dns_resolvers.json (compilada en el binario con include_str!).
# DNS_DOT_SERVERS es solo la cadena de fallback para cuando el operador exige otro proveedor.
DNS_TIMEOUT_MS=3000
DNS_RETRIES_PER_SERVER=2
DNS_CACHE_SIZE=256
DNS_DOT_SERVERS=dns.quad9.net:853,security.cloudflare-dns.com:853,dns.adguard-dns.com:853,security-dns.nl:853,dns.google:853

# --- Seguridad ---
CRYPT_ID_LENGTH=12
BEARER_TOKEN_HASH_ALGORITHM=sha256
